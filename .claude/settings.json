{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/load-product-context.sh\"",
            "timeout": 10,
            "statusMessage": "Loading product context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-typography.sh\"",
            "timeout": 10,
            "statusMessage": "Checking typography"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["context7"]
}
